<!-- FullCalendar CSS -->
<link href="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.11/index.global.min.css" rel="stylesheet" />

<!-- FullCalendar JS -->
<script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.11/index.global.min.js"></script>

<script>
document.addEventListener('DOMContentLoaded', async function() {
  const calendarEl = document.getElementById('calendar');
  if (!calendarEl) return;

  // SAFE USER VALUES
  const currentUserRole = "<%= user?.role || '' %>";
  const currentUserName = "<%= user?.fullName || '' %>";

  async function fetchSlots() {
    const res = await fetch('/calendar/slots');
    const data = await res.json();

    return data.map(slot => ({
      id: slot.slot_id,
      title: `${slot.mentor_name} (${slot.booked_count}/${slot.capacity})`,
      start: slot.start_time,
      end: slot.end_time,
      extendedProps: { 
        slotId: slot.slot_id,
        capacity: slot.capacity,
        bookedCount: slot.booked_count
      },
      backgroundColor: slot.booked_count >= slot.capacity ? '#f39c12' : '#28a745',
      borderColor: '#000',
      textColor: '#fff'
    }));
  }

  const calendar = new FullCalendar.Calendar(calendarEl, {
    initialView: 'dayGridMonth',
    selectable: true,
    editable: false,
    headerToolbar: {
      left: 'prev,next today',
      center: 'title',
      right: 'dayGridMonth,timeGridWeek,timeGridDay'
    },
    events: await fetchSlots(),

    // ===============================
    // Mentor Creates Slot
    // ===============================
    select: async function(info) {

      if (currentUserRole !== 'mentor') return;

      const capacity = prompt('Enter capacity (default 1):') || 1;

      try {
        const res = await fetch('/calendar/slots', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            start_time: info.startStr,
            end_time: info.endStr,
            capacity
          })
        });

        const newSlot = await res.json();

        calendar.addEvent({
          id: newSlot.slot_id,
          title: `${currentUserName} (0/${newSlot.capacity})`,
          start: newSlot.start_time,
          end: newSlot.end_time,
          extendedProps: { 
            slotId: newSlot.slot_id,
            capacity: newSlot.capacity,
            bookedCount: 0
          },
          backgroundColor: '#28a745',
          borderColor: '#000',
          textColor: '#fff'
        });

        alert('Slot created!');
      } catch (err) {
        console.error(err);
        alert('Failed to create slot');
      }

      calendar.unselect();
    },

    // ===============================
    // Learner Books Slot
    // ===============================
    eventClick: async function(info) {
      const slot = info.event.extendedProps;

      if (currentUserRole === 'mentor') {
        alert('Mentor cannot book slots.');
        return;
      }

      const confirmBooking = confirm(`Book slot with ${info.event.title}?`);
      if (!confirmBooking) return;

      try {
        const res = await fetch(`/calendar/slots/${slot.slotId}/book`, { method: 'POST' });

        if (res.status === 400) {
          alert('Already booked this slot');
          return;
        }

        const booking = await res.json();

        if (booking.status === 'confirmed') {
          alert('Slot booked successfully!');
          info.event.setProp(
            'title',
            `${info.event.title.split('(')[0]}(${slot.bookedCount + 1}/${slot.capacity})`
          );
          info.event.setProp(
            'backgroundColor',
            (slot.bookedCount + 1 >= slot.capacity) ? '#f39c12' : '#28a745'
          );
        } else {
          alert('Slot full! You are on the waitlist.');
        }

      } catch (err) {
        console.error(err);
        alert('Failed to book slot');
      }
    }
  });

  calendar.render();
});
</script>
