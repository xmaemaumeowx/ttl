<%- include('partials/header', { pageTitle: "Learner Calendar | The Tech Lab" }) %>
<%- include('partials/navbar') %>

<div class="dashboard">
  <%- include('partials/sidebar', { activePage: 'calendar', user: user }) %>

  <main class="dashboard-main-content">
    <h1 class="page-title">📅 Learner Calendar</h1>
      <% if (user?.role === 'mentor') { %>
        <p>Add your available mentor slots below.</p>
      <% } else { %>
        <p>View and book available mentor slots below.</p>
      <% } %>

    <!-- TTL Calendar Container -->
    <div id="calendar" class="ttl-calendar"></div>
  </main>
</div>

<%- include('partials/footer') %>

<!-- FullCalendar CSS & JS -->
<link href="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.11/index.global.min.css" rel="stylesheet" />
<script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.11/index.global.min.js"></script>

<script>
document.addEventListener('DOMContentLoaded', async function() {
  const calendarEl = document.getElementById('calendar');
  if (!calendarEl) return;

  const currentUserRole = "<%= user?.role || '' %>";
  const currentUserName = "<%= user?.full_name || '' %>";

  // Fetch slots from backend
  async function fetchSlots() {
    try {
      const res = await fetch('/calendar/slots');
      const data = await res.json();

      if (!data || !Array.isArray(data) || data.length === 0) return [];

      return data.map(slot => ({
        id: slot.slot_id,
        title: `${slot.mentor_name} (${slot.booked_count}/${slot.capacity})`,
        start: slot.start_time,
        end: slot.end_time,
        extendedProps: {
          slotId: slot.slot_id,
          capacity: slot.capacity,
          bookedCount: slot.booked_count
        },
        backgroundColor: slot.booked_count >= slot.capacity ? '#f39c12' : '#28a745',
        borderColor: '#000',
        textColor: '#fff'
      }));
    } catch (err) {
      console.error('Failed to fetch slots:', err);
      return [];
    }
  }

  const calendar = new FullCalendar.Calendar(calendarEl, {
    initialView: 'dayGridMonth',
    selectable: true,
    editable: false,
    navLinks: true,
    dayMaxEvents: true,
    headerToolbar: {
      left: 'prev,next today',
      center: 'title',
      right: 'dayGridMonth,timeGridWeek,timeGridDay,listWeek'
    },
    events: await fetchSlots(),
    noEventsContent: 'No slots available yet.', // TTL fallback message

    // ===============================
    // Mentor Creates Slot
    // ===============================
    select: async function(info) {
      if (currentUserRole !== 'mentor') return;

      const capacity = prompt('Enter capacity (default 1):') || 1;

      try {
        const res = await fetch('/calendar/slots', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            start_time: info.startStr,
            end_time: info.endStr,
            capacity
          })
        });

        const newSlot = await res.json();

        calendar.addEvent({
          id: newSlot.slot_id,
          title: `${currentUserName} (0/${newSlot.capacity})`,
          start: newSlot.start_time,
          end: newSlot.end_time,
          extendedProps: {
            slotId: newSlot.slot_id,
            capacity: newSlot.capacity,
            bookedCount: 0
          },
          backgroundColor: '#28a745',
          borderColor: '#000',
          textColor: '#fff'
        });

        alert('Slot created!');
      } catch (err) {
        console.error(err);
        alert('Failed to create slot');
      }

      calendar.unselect();
    },

    // ===============================
    // Learner Books Slot
    // ===============================
    eventClick: async function(info) {
      const slot = info.event.extendedProps;

      if (currentUserRole === 'mentor') {
        alert('Mentor cannot book slots.');
        return;
      }

      const confirmBooking = confirm(`Book slot with ${info.event.title}?`);
      if (!confirmBooking) return;

      try {
        const res = await fetch(`/calendar/slots/${slot.slotId}/book`, { method: 'POST' });

        if (res.status === 400) {
          alert('Already booked this slot');
          return;
        }

        const booking = await res.json();

        if (booking.status === 'confirmed') {
          alert('Slot booked successfully!');

          // Update event title and color
          const newBookedCount = slot.bookedCount + 1;
          info.event.setProp(
            'title',
            `${info.event.title.split('(')[0]}(${newBookedCount}/${slot.capacity})`
          );
          info.event.setProp(
            'backgroundColor',
            newBookedCount >= slot.capacity ? '#f39c12' : '#28a745'
          );

          slot.bookedCount = newBookedCount; // update extendedProps
        } else {
          alert('Slot full! You are on the waitlist.');
        }
      } catch (err) {
        console.error(err);
        alert('Failed to book slot');
      }
    }
  });

  calendar.render();
});
</script>

<style>
/* TTL-style calendar container */
.ttl-calendar {
  background: #f8fafc;
  border-radius: 12px;
  padding: 1rem;
  box-shadow: 0 2px 6px rgba(0,0,0,0.1);
}
</style>
