<%- include('partials/header', { pageTitle: "Courses | The Tech Lab" }) %>
<%- include('partials/navbar') %>

<%
  // Always define these before any usage (prevents "safeCourses is not defined")
  const safeUser = locals.user || user || {
    fullName: 'Guest',
    role: 'guest',
    avatar: ''
  };

  const safeCourses = Array.isArray(courses) ? courses : [];
%>

<div class="dashboard">
  <%- include('partials/sidebar', { activePage: 'courses', user: safeUser }) %>

  <main class="dashboard-main-content">
    <h1 class="page-title">📚 My Courses</h1>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="toast error"><%= error %></div>
    <% } %>

    <% if (safeCourses.length === 0) { %>
      <div class="empty-state">
        <h4>No courses available</h4>
        <% if (safeUser.role === 'mentor') { %>
          <p>You are not yet assigned to any learning track.</p>
        <% } else { %>
          <p>You are not enrolled in any learning track yet.</p>
        <% } %>
      </div>
    <% } else { %>

      <%
        let currentTrack = null;
      %>

      <% safeCourses.forEach((course, idx) => { %>
        <% if (currentTrack !== course.track_name) { %>
          <% if (currentTrack !== null) { %>
            </div>
          <% } %>

          <% currentTrack = course.track_name; %>
          <div class="ttl-track-section">
            <h3 class="ttl-track-title"><%= course.track_name %></h3>
        <% } %>

            <div class="ttl-course-card">
              <div class="ttl-course-order">
                Module <%= course.order_no %>
              </div>
              <div class="ttl-course-content">
                <h5><%= course.course_name %></h5>
                <% if (course.description) { %>
                  <p><%= course.description %></p>
                <% } %>
              </div>
            </div>

        <% if (idx === safeCourses.length - 1) { %>
          </div>
        <% } %>
      <% }) %>

    <% } %>
  </main>
</div>

<%- include('partials/footer') %>