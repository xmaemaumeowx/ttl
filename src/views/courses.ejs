<%- include('partials/header') %>
<%- include('partials/navbar') %>

<div class="dashboard">
  <%- include('partials/sidebar', { activePage: 'courses' }) %>

  <main class="dashboard-main-content">
    <h1 class="page-title">Courses</h1>

    <!-- Toast messages -->
    <% if (success) { %>
      <div class="toast toast-success show"><%= success %></div>
    <% } %>
    <% if (error) { %>
      <div class="toast toast-error show"><%= error %></div>
    <% } %>

    <% if (!courses || courses.length === 0) { %>
      <div class="no-data">No courses found.</div>
    <% } else { %>

      <!-- COURSES GRID -->
      <div class="tracks-grid">

        <% courses.forEach(courses => { %>
          <div class="track-card">

            <!-- Course Header -->
            <div class="course-header">
              <h3><%= courses.course_name %></h3>
            </div>

            <!-- Course Body -->
            <div class="course-card">
              <p>
                <%= courses.description || 'No description provided.' %>
              </p>
            </div>

            <!-- Mentor Actions -->
            <% if (user && user.role === 'mentor') { %>
              <div class="mentor-actions">
                <form
                  action="/courses/delete/<%= courses.course_id %>"
                  method="POST"
                  onsubmit="return confirm('Are you sure you want to delete this course?');"
                >
                  <button type="submit" class="delete-btn">Delete</button>
                </form>
              </div>
            <% } %>

          </div>
        <% }) %>

      </div>
    <% } %>
  </main>
</div>

<%- include('partials/footer') %>
