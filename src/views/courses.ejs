<%- include('partials/header') %>
<%- include('partials/navbar') %>
<div class="dashboard">
  <%- include('partials/sidebar', { activePage: 'courses' }) %>
  <main class="dashboard-main-content">
    <h1 class="page-title">Courses</h1>

    <!-- Toast messages -->
    <% if (success) { %>
      <div class="toast success"><%= success %></div>
    <% } %>
    <% if (error) { %>
      <div class="toast error"><%= error %></div>
    <% } %>

    <% if (!courses || courses.length === 0) { %>
      <p class="no-data">No courses found.</p>
    <% } else { %>
      <div class="courses-grid">
        <% courses.forEach(course => { %>
          <div class="course-card">
            <h3><%= course.course_name %></h3>
            <p><%= course.description || 'No description provided.' %></p>
            <% if (user.role === 'mentor') { %>
              <form action="/courses/delete/<%= course.course_id %>" method="POST" onsubmit="return confirm('Are you sure you want to delete this course?');">
                <button class="delete-btn">Delete</button>
              </form>
            <% } %>
          </div>
        <% }) %>
      </div>
    <% } %>
  </main>
</div>
<%- include('partials/footer') %>
