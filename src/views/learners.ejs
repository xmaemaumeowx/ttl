<%- include('partials/header', { pageTitle }) %>
<%- include('partials/navbar') %>

<div class="dashboard">
  <%- include('partials/sidebar', { activePage }) %>

  <main class="dashboard-main-content">
    <h1 class="page-title">My Learners</h1>

    <% if (!learners || learners.length === 0) { %>
      <p class="no-data">No learners assigned to you.</p>
    <% } else { %>
      <table class="learners-table">
        <thead>
          <tr>
            <th>Initials</th>
            <th>Name</th>
            <th>Email</th>
          </tr>
        </thead>

        <tbody>
          <% learners.forEach((learner) => { %>
            <tr>
              <td>
                <%
                    const initials = (learner.full_name || "")
                      .split(/\s+/).filter(Boolean).slice(0,2)
                      .map(s => s[0].toUpperCase()).join("");
                  %>
                  <div class="avatar-circle" title="<%= learner.full_name %>"><%= initials %></div>
              </td>

              <td><%= learner.full_name %></td>
              <td><%= learner.email %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } %>
  </main>
</div>

<%- include('partials/footer') %>