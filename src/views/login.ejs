<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Login | The Tech Lab</title>
  <link rel="stylesheet" href="/style.css" />
</head>
<body>
  <div class="container">
    <!-- Left Login Box -->
    <div class="login-box">
      <div id="toast" class="toast"></div>

      <div class="logo"><h1>The Tech Lab</h1></div>

      <h2>Log In</h2>
      <form id="loginForm">
        <div class="form-group">
          <input type="email" id="email" name="email" placeholder="Email address" required autocomplete="email">
        </div>
        <div class="form-group">
          <input type="password" id="password" name="password" placeholder="Password" required autocomplete="current-password">
        </div>
        <label><input type="checkbox"> Remember Me</label>
        <button id="LoginBtn" class="submit-btn" type="submit">🔒 Log In</button>
      </form>

      <!-- Google Sign-In Button -->
      <div id="googleSignInDiv" style="margin-top: 15px; text-align: center;"></div>

      <div class="forgot">
        <a href="#">Forgot your password?</a>
        <p>Don't have an account? <a href="#" id="show-signup">Sign Up!</a></p>
      </div>

      <!-- Sign Up Modal -->
      <div id="signup-modal" class="modal">
        <div class="modal-content">
          <span class="close" id="close-signup">&times;</span>
          <h2>Sign Up</h2>
          <form id="signupForm">
            <input type="text" id="signup-name" name="full_name" placeholder="Full Name" required autocomplete="name"><br>
            <input type="email" id="signup-email" name="email" placeholder="Email" required autocomplete="email"><br>
            <input type="password" id="signup-password" name="password" placeholder="Password" required autocomplete="new-password"><br>
            <button type="submit">Create Account</button>
          </form>
          <!-- Google Sign-Up Button -->
          <div id="googleSignUpDiv" style="margin-top: 10px; text-align: center;"></div>
        </div>
      </div>

      <div class="legal">
        By clicking on Log In, you agree to our
        <a href="#">Terms of Use</a> and <a href="#">Privacy Policy</a>.
      </div>
    </div>

    <!-- Right Promo Container -->
    <div class="promo-box">
      <div class="card">
        <h3>3-month Data Analytics Program</h3>
        <p><strong>Registration starts now until August 30, 2025</strong></p>
        <p>
          Participants will build foundational data analytics skills, apply them through
          hands-on projects, and be career-ready in just three months.
        </p>
        <button id="signupBtn">Sign up today</button>
      </div>
      <div class="card alt">
        <h3>Mentor Check</h3>
        <p>Check your mentor list and availability schedule.</p>
        <button class="learn">Learn more</button>
      </div>
    </div>
  </div>

  <!-- Google One Tap / Sign-In Script -->
  <script src="https://accounts.google.com/gsi/client" async defer></script>
  <script>
    // Grab the client ID from server-side safely
    const GOOGLE_CLIENT_ID = "<%= GOOGLE_CLIENT_ID || '' %>";

    // Only initialize Google Sign-In if client ID exists
    if (GOOGLE_CLIENT_ID) {
      function handleCredentialResponse(response) {
        fetch('/auth/google', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ token: response.credential })
        })
        .then(res => res.json())
        .then(data => {
          if (data.success) {
            // Set JWT in cookie
            document.cookie = `token=${data.jwt}; path=/; max-age=86400`; // 1 day
            window.location.href = '/dashboard';
          } else {
            console.error('Google login failed:', data.message);
            alert('Google login failed');
          }
        })
        .catch(err => {
          console.error('Google login error:', err);
          alert('Error logging in with Google');
        });
      }

      window.onload = function () {
        google.accounts.id.initialize({
          client_id: GOOGLE_CLIENT_ID,
          callback: handleCredentialResponse
        });

        // Render buttons
        google.accounts.id.renderButton(
          document.getElementById("googleSignInDiv"),
          { theme: "outline", size: "large", shape: "pill" }
        );
        google.accounts.id.renderButton(
          document.getElementById("googleSignUpDiv"),
          { theme: "outline", size: "large", shape: "pill" }
        );

        google.accounts.id.prompt(); // optional One Tap
      };
    } else {
      console.warn("⚠️ GOOGLE_CLIENT_ID is not set. Google Sign-In disabled.");
    }
  </script>

  <!-- Main JS -->
  <script src="/script.js"></script>
</body>
</html>
