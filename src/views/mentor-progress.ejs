<%- include('partials/header') %>
<%- include('partials/navbar') %>
<div class="dashboard">
  <%- include('partials/sidebar', { activePage: 'reports' }) %>
  <main class="dashboard-main-content">
    <h1 class="page-title">Mentor Progress Dashboard</h1>

    <!-- Toast messages -->
    <% if (success) { %>
      <div class="toast success"><%= success %></div>
    <% } %>
    <% if (error) { %>
      <div class="toast error"><%= error %></div>
    <% } %>

    <% if ((!learners || learners.length === 0) &&
           (!courses || courses.length === 0) &&
           (!projects || projects.length === 0)) { %>
      <p class="no-data">No learners, courses, or projects found.</p>
    <% } else { %>

      <!-- ===== Filter by Learner ===== -->
      <section>
        <label for="learnerFilter"><strong>Filter by Learner:</strong></label>
        <select id="learnerFilter">
          <option value="all">All</option>
          <% learners.forEach(learner => { %>
            <option value="learner-<%= learner.user_id %>"><%= learner.full_name %></option>
          <% }) %>
        </select>
      </section>

      <!-- ===== Courses Progress ===== -->
      <section id="coursesSection">
        <h2>Course Progress</h2>
        <% learners.forEach(learner => { %>
          <div class="learner-card learner-<%= learner.user_id %>">
            <h3><%= learner.full_name %></h3>
            <% 
              const learnerCourses = courses.filter(c => c.user_id === learner.user_id);
            %>
            <% if (!learnerCourses || learnerCourses.length === 0) { %>
              <p>No courses assigned.</p>
            <% } else { %>
              <% learnerCourses.forEach(course => { %>
                <div class="course-card">
                  <strong><%= course.course_name %></strong>
                  <p>Status: <%= course.progress || "Not Started" %></p>
                </div>
              <% }) %>
            <% } %>
          </div>
        <% }) %>
      </section>

      <!-- ===== Projects Progress ===== -->
      <section id="projectsSection">
        <h2>Projects</h2>
        <% learners.forEach(learner => { %>
          <div class="learner-card learner-<%= learner.user_id %>">
            <h3><%= learner.full_name %></h3>
            <% 
              const learnerProjects = projects.filter(p => p.learner_id === learner.user_id);
            %>
            <% if (!learnerProjects || learnerProjects.length === 0) { %>
              <p>No projects assigned.</p>
            <% } else { %>
              <ul>
                <% learnerProjects.forEach(proj => { %>
                  <li>
                    <strong><%= proj.name %></strong> - <%= proj.status || 'Planned' %> 
                    <% if (proj.github_link) { %> | <a href="<%= proj.github_link %>" target="_blank">GitHub</a> <% } %>
                    <% if (proj.live_link) { %> | <a href="<%= proj.live_link %>" target="_blank">Live</a> <% } %>
                  </li>
                <% }) %>
              </ul>
            <% } %>
          </div>
        <% }) %>
      </section>

    <% } %>
  </main>
</div>

<%- include('partials/footer') %>

<script>
  // Filter by learner
  const learnerFilter = document.getElementById('learnerFilter');
  learnerFilter.addEventListener('change', () => {
    const value = learnerFilter.value;
    document.querySelectorAll('.learner-card').forEach(card => {
      card.style.display = (value === 'all' || card.classList.contains(value)) ? 'block' : 'none';
    });
  });
</script>

<style>
  .toast {
    padding: 10px 15px;
    margin-bottom: 10px;
    border-radius: 5px;
    font-weight: bold;
  }
  .toast.success { background-color: #4caf50; color: white; }
  .toast.error { background-color: #f44336; color: white; }

  .learner-card {
    border: 1px solid #ddd;
    padding: 10px;
    margin-bottom: 15px;
    border-radius: 8px;
    background-color: #fff;
  }

  .course-card {
    border: 1px solid #eee;
    padding: 8px;
    margin: 5px 0;
    border-radius: 5px;
    background-color: #f9f9f9;
  }
</style>

