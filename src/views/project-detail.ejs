<%- include('partials/header'); %>
<%- include('partials/navbar', { activePage: 'projects' }); %>
<div class="dashboard">
  <%- include('partials/sidebar', { activePage: 'projects' }); %>
  <main>
    <section class="content-section">
      <div class="project-detail-card">
        <div class="project-header">
          <h2><%= project.NAME %></h2>
          <% if (project.STATUS) { %>
            <span class="project-status <%= project.STATUS.toLowerCase() %>"><%= project.STATUS %></span>
          <% } %>
        </div>
        <div class="project-body">
          <p><strong>Start Date:</strong> <%= project.START_DATE ? project.START_DATE.toISOString().split('T')[0] : 'N/A' %></p>
          <p><strong>End Date:</strong> <%= project.END_DATE ? project.END_DATE.toISOString().split('T')[0] : 'N/A' %></p>
          <p><strong>Technology Stack:</strong> <%= project.TECHNOLOGY_STACK || 'N/A' %></p>
          <p><strong>Description:</strong> <%= project.DESCRIPTION || 'No description provided.' %></p>
          <p><strong>Track:</strong> <%= project.TRACK_NAME || 'N/A' %></p>
          <p><strong>GitHub Link:</strong>
            <% if (project.GITHUB_LINK) { %>
              <a href="<%= project.GITHUB_LINK %>" target="_blank" class="ext-link"><%= project.GITHUB_LINK %></a>
            <% } else { %> N/A <% } %>
          </p>
          <p><strong>Live Link:</strong>
            <% if (project.LIVE_LINK) { %>
              <a href="<%= project.LIVE_LINK %>" target="_blank" class="ext-link"><%= project.LIVE_LINK %></a>
            <% } else { %> N/A <% } %>
          </p>
        </div>
        <div class="project-footer">
          <a href="/projects/edit/<%= project.PROJECT_ID %>" class="edit-btn">Edit Project</a>
          <a href="/projects" class="back-btn">Back to Projects</a>
        </div>
      </div>

      <!-- Toast Notifications -->
      <% if (typeof success !== 'undefined' && success) { %>
        <div id="toast" class="toast"><%= success %></div>
      <% } else if (typeof error !== 'undefined' && error) { %>
        <div id="toast" class="toast error"><%= error %></div>
      <% } %>
    </section>
  </main>
</div>
<%- include('partials/footer'); %>
