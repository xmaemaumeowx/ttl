<%- include('partials/header', { pageTitle: "Projects | The Tech Lab" }) %>
<%- include('partials/navbar') %>
<div class="dashboard">
  <%- include('partials/sidebar', { activePage: 'projects', user: user }) %>

  <main class="dashboard-main-content">
    <h1 class="page-title">My Projects</h1>

    <!-- Toast messages -->
    <% if (success) { %>
      <div class="toast success"><%= success %></div>
    <% } %>
    <% if (error) { %>
      <div class="toast error"><%= error %></div>
    <% } %>

    <% if (!projects || projects.length === 0) { %>
      <p class="no-data">No projects found.</p>
    <% } else { %>
      
      <% if (user.role === 'mentor') { %>
        <!-- ===== Mentor Table View ===== -->
        <div style="overflow-x:auto;">
          <table class="projects-table">
            <thead>
              <tr>
                <th>Project ID</th>
                <th>Name</th>
                <th>Description</th>
                <th>Status</th>
                <th>Start Date</th>
                <th>End Date</th>
                <th>Technology Stack</th>
                <th>GitHub</th>
                <th>Live Link</th>
                <th>Track</th>
                <th>Learner</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody>
              <% projects.forEach(project => { %>
                <tr>
                  <td><%= project.project_id %></td>
                  <td><%= project.name %></td>
                  <td><%= project.description %></td>
                  <td><%= project.status %></td>
                  <td><%= project.start_date ? new Date(project.start_date).toLocaleDateString() : '' %></td>
                  <td><%= project.end_date ? new Date(project.end_date).toLocaleDateString() : '' %></td>
                  <td><%= project.technology_stack %></td>
                  <td>
                    <% if (project.github_link) { %>
                      <a href="<%= project.github_link %>" target="_blank">GitHub</a>
                    <% } %>
                  </td>
                  <td>
                    <% if (project.live_link) { %>
                      <a href="<%= project.live_link %>" target="_blank">Live</a>
                    <% } %>
                  </td>
                  <td><%= project.track_name || '' %></td>
                  <td><%= project.learner_name || '' %></td>
                  <td>
                    <a href="/projects/edit/<%= project.project_id %>" class="edit-btn">Edit</a>
                    <form action="/projects/delete/<%= project.project_id %>" method="POST" style="display:inline;" onsubmit="return confirm('Are you sure you want to delete this project?');">
                      <button type="submit" class="delete-btn">Delete</button>
                    </form>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } else { %>
        <!-- ===== Learner Card View ===== -->
        <div class="projects-grid">
          <% projects.forEach(project => { %>
            <div class="project-card <%= project.status ? project.status.toLowerCase().replace(' ', '-') : '' %>">
              <div class="project-header">
                <h3 class="project-title"><%= project.name %></h3>
                <% if (project.status) { %>
                  <span class="project-status <%= project.status.toLowerCase().replace(' ', '-') %>"><%= project.status %></span>
                <% } %>
              </div>
              <div class="project-body">
                <% if (project.start_date) { %>
                  <p><strong>Start Date:</strong> <%= new Date(project.start_date).toLocaleDateString() %></p>
                <% } %>
                <% if (project.end_date) { %>
                  <p><strong>End Date:</strong> <%= new Date(project.end_date).toLocaleDateString() %></p>
                <% } else { %>
                  <p><strong>End Date:</strong> Ongoing</p>
                <% } %>
                <% if (project.technology_stack) { %>
                  <p><strong>Technology Stack:</strong> <%= project.technology_stack %></p>
                <% } %>
                <% if (project.github_link) { %>
                  <p><strong>GitHub:</strong> <a href="<%= project.github_link %>" target="_blank">View Repo</a></p>
                <% } %>
                <% if (project.live_link) { %>
                  <p><strong>Live Link:</strong> <a href="<%= project.live_link %>" target="_blank">View Project</a></p>
                <% } %>
              </div>
              <div class="project-footer">
                <a href="/projects/<%= project.project_id %>" class="view-btn">View Details</a>
              </div>
            </div>
          <% }) %>
        </div>
      <% } %>

    <% } %>
  </main>
</div>

<%- include('partials/footer') %>

