<%- include('partials/header', { pageTitle: "My Reports | The Tech Lab" }) %>
<%- include('partials/navbar') %>
<div class="dashboard">
  <%- include('partials/sidebar', { activePage: 'reports', user: user }) %>
<div class="container mt-4">
  <h2 class="mb-3">📊 My Learning Progress</h2>

  <% if (success) { %>
    <div class="alert alert-success"><%= success %></div>
  <% } %>

  <% if (error) { %>
    <div class="alert alert-danger"><%= error %></div>
  <% } %>

  <table class="table table-bordered table-hover align-middle">
    <thead class="table-dark">
      <tr>
        <th>Course</th>
        <th>Progress (%)</th>
        <th>Milestones Reached</th>
        <th>Status</th>
      </tr>
    </thead>
    <tbody>
      <% if (reports.length === 0) { %>
        <tr>
          <td colspan="4" class="text-center text-muted">
            No course progress available yet.
          </td>
        </tr>
      <% } %>

      <% reports.forEach(r => { %>
        <tr>
          <td><%= r.course_name %></td>
          <td>
            <strong><%= r.progress %>%</strong>
          </td>
          <td><%= r.milestones %></td>
          <td>
            <span class="badge 
              <%= r.status === 'Completed' ? 'bg-success' :
                  r.status === 'On Track' ? 'bg-primary' :
                  'bg-warning text-dark' %>">
              <%= r.status %>
            </span>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>
</div>

<%- include("partials/footer") %>
