<%- include('partials/header', { pageTitle: "Reports | The Tech Lab" }) %>
<%- include('partials/navbar') %>

<div class="dashboard">
  <%- include('partials/sidebar', { activePage: 'reports', user: user }) %>

  <main class="dashboard-main-content">
    <h1 class="page-title">📊 Learning Reports</h1>
    <p class="text-muted">Your course progress and milestones overview</p>

    <!-- Toast messages -->
    <% if (success) { %>
      <div class="toast success"><%= success %></div>
    <% } %>

    <% if (error) { %>
      <div class="toast error"><%= error %></div>
    <% } %>

    <% if (!reports || reports.length === 0) { %>
      <div class="empty-state">
        <i class="fas fa-chart-line"></i>
        <h4>No progress data yet</h4>
        <p>Once you start working on projects, your learning progress will appear here.</p>
      </div>
    <% } else { %>

      <div style="overflow-x:auto;">
        <table class="projects-table">
          <thead>
            <tr>
              <th>Learning Track</th>
              <th>Progress</th>
              <th>Milestones Reached</th>
              <th>Status</th>
            </tr>
          </thead>
          <tbody>
            <% reports.forEach(r => { %>
              <tr>
                <!-- Track Name -->
                <td><strong><%= r.track_name %></strong></td>

                <!-- Progress Bar -->
                <td style="min-width:220px;">
                  <div class="progress ttl-progress">
                    <div class="progress-bar
                        <%= r.progress === 100 ? 'bg-success' :
                            r.progress >= 50 ? 'bg-primary' :
                            'bg-secondary' %>"
                         style="width:<%= r.progress || 0 %>%">
                      <%= r.progress || 0 %>%
                    </div>
                  </div>
                </td>

                <!-- Milestones -->
                <td>
                  <span class="badge ttl-badge"><%= r.milestones || 0 %></span>
                </td>

                <!-- Status -->
                <td>
                  <span class="status-pill
                    <%= r.status === 'Completed' ? 'status-complete' :
                        r.status === 'Ongoing' ? 'status-active' :
                        'status-planned' %>">
                    <%= r.status %>
                  </span>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>

    <% } %>
  </main>
</div>

<%- include('partials/footer') %>
