<%- include('partials/header', { pageTitle: "Reports | The Tech Lab" }) %>
<%- include('partials/navbar') %>

<div class="dashboard">
  <%- include('partials/sidebar', { activePage: 'reports', user: user }) %>

  <main class="dashboard-main-content">
    <h1 class="page-title">📊 Learning Reports</h1>

    <% if (!reports || reports.length === 0) { %>
      <div class="empty-state">
        <p>No projects found for this account.</p>
      </div>
    <% } else { %>
      <div style="overflow-x:auto;">
        <table class="projects-table">
          <thead>
            <tr>
              <th>Learning Track</th>
              <th>Progress</th>
              <th>Milestones</th>
              <th>Status</th>
            </tr>
          </thead>
          <tbody>
            <% reports.forEach(r => { %>
              <tr>
                <td><strong><%= r.track_name %></strong></td>

                <td style="min-width:200px;">
                  <div class="progress ttl-progress" style="height: 20px; background: #e9ecef; border-radius: 4px;">
                    <div class="progress-bar 
                        <%= r.progress === 100 ? 'bg-success' : 'bg-primary' %>" 
                         style="width: <%= r.progress %>%">
                      <%= r.progress %>%
                    </div>
                  </div>
                </td>

                <td>
                  <span class="badge ttl-badge"><%= r.milestones %></span>
                </td>

                <td>
                  <span class="status-pill 
                    <%= r.status === 'Completed' ? 'status-complete' : 'status-active' %>">
                    <%= r.status %>
                  </span>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </main>
</div>

<%- include('partials/footer') %>