<%- include('partials/header') %>
<%- include('partials/navbar') %>
<div class="dashboard">
  <%- include('partials/sidebar', { activePage: 'reports' }) %>
  <main class="dashboard-main-content">
    <h1 class="page-title">Reports</h1>

    <!-- Toast messages -->
    <% if (success) { %>
      <div class="toast success"><%= success %></div>
    <% } %>
    <% if (error) { %>
      <div class="toast error"><%= error %></div>
    <% } %>

    <% if (!courses || courses.length === 0) { %>
      <p class="no-data">No courses or learners found.</p>
    <% } else { %>
      <table class="reports-table">
        <thead>
          <tr>
            <th>Course Name</th>
            <th>Description</th>
            <th># of Learners</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% courses.forEach(course => { %>
            <tr>
              <td><%= course.course_name %></td>
              <td><%= course.description %></td>
              <td><%= course.learner_count %></td>
              <td>
                <a href="/reports/course/<%= course.course_id %>" class="view-btn">View Progress</a>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } %>
  </main>
</div>
<%- include('partials/footer') %>
