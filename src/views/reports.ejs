<%- include('partials/header', { pageTitle: "Reports | The Tech Lab" }) %>
<%- include('partials/navbar') %>

<div class="dashboard">
  <%- include('partials/sidebar', { activePage: 'reports', user: user }) %>

  <main class="dashboard-main-content">
    <h1 class="page-title">📊 Learning Reports</h1>
    <p class="text-muted">Your course progress and milestones overview</p>

    <% if (success && success.length > 0) { %>
      <div class="toast success"><%= success[0] %></div>
    <% } %>

    <% if (error && error.length > 0) { %>
      <div class="toast error"><%= error[0] %></div>
    <% } %>

    <% if (!reports || reports.length === 0) { %>
      <div class="empty-state">
        <i class="fas fa-chart-line"></i>
        <h4>No progress data yet</h4>
        <p>Once you start working on projects, your learning progress will appear here.</p>
      </div>
    <% } else { %>

      <div style="overflow-x:auto;">
        <table class="projects-table">
          <thead>
            <tr>
              <th>Learning Track</th>
              <th>Total Projects</th>
              <th>Completed Projects</th>
              <th>Status</th>
            </tr>
          </thead>
          <tbody>
            <% reports.forEach(r => { %>
              <tr>
                <td><strong><%= r.track_name %></strong></td>

                <td>
                  <div class="progress ttl-progress">
                    <div 
                      class="progress-bar <%= (Number(r.progress) === 100) ? 'bg-success' : 'bg-primary' %>" 
                      style="width: <%= Number(r.progress) || 0 %>%;">
                      <%= Number(r.progress) || 0 %>%
                    </div>
                  </div>
                </td>

                <td>
                  <span class="badge ttl-badge"><%= r.milestones || 0 %></span>
                </td>

                <td>
                  <span class="status-pill 
                    <%= r.status === 'Completed' 
                        ? 'status-complete' 
                        : r.status === 'In Progress'
                        ? 'status-active'
                        : 'status-planned' %>">
                    <%= r.status || 'Not Started' %>
                  </span>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>

    <% } %>
  </main>
</div>

<%- include('partials/footer') %>
