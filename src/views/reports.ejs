<%- include('partials/header', { pageTitle: "Reports | The Tech Lab" }) %>
<%- include('partials/navbar') %>

<div class="dashboard">
  <%- include('partials/sidebar', { activePage: 'reports' }) %>

  <main class="dashboard-main-content">
    <h1 class="page-title">📊 Learning Reports</h1>
    <p class="text-muted">Your course progress and milestones overview</p>

    <% if (!reports || reports.length === 0) { %>
      <div class="empty-state">
        <h4>No progress data yet</h4>
        <p>Once you start working on projects, your learning progress will appear here.</p>
      </div>
    <% } else { %>

      <div style="overflow-x:auto;">
        <table class="projects-table">
          <thead>
            <tr>
              <th>Learning Track</th>
              <th>Progress</th>
              <th>Completed</th>
              <th>Status</th>
            </tr>
          </thead>
          <tbody>
            <% reports.forEach(r => { %>
              <tr>
                <td>
                  <strong><%= r.track_name %></strong>
                </td>

                <!-- Progress Column -->
                <td style="min-width:200px;">
                  <div class="ttl-progress-container">
                    <div class="ttl-progress-bar"
                         style="width: <%= r.progress %>%;">
                    </div>
                  </div>
                  <small><%= r.progress %>% Complete</small>
                </td>

                <!-- Completed Column -->
                <td>
                  <span class="badge ttl-badge">
                    <%= r.completed_projects %> / <%= r.total_projects %>
                  </span>
                </td>

                <!-- Status Column -->
                <td>
                  <span class="status-pill 
                    <%= r.status === 'Completed' 
                        ? 'status-complete' 
                        : r.status === 'In Progress'
                        ? 'status-active'
                        : 'status-planned' %>">
                    <%= r.status %>
                  </span>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>

    <% } %>
  </main>
</div>

<%- include('partials/footer') %>
