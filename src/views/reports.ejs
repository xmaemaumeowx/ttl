<%- include('partials/header', { pageTitle: "Reports | The Tech Lab" }) %>
<%- include('partials/navbar') %>

<%
  const safeUser = locals.user || user || {
    fullName: 'Guest',
    role: 'guest',
    avatar: ''
  };
  const safeReports = Array.isArray(reports) ? reports : [];
%>

<div class="dashboard">
  <%- include('partials/sidebar', { activePage: 'reports', user: safeUser }) %>

  <main class="dashboard-main-content">
    <h1 class="page-title">📊 Learner Reports</h1>
    <p class="text-muted">Track progress overview</p>

    <% if (safeReports.length === 0) { %>
      <div class="empty-state">
        <h4>No progress data yet</h4>
        <p>If you just enrolled, progress will appear once projects are added.</p>
      </div>
    <% } else { %>
      <div style="overflow-x:auto;">
        <table class="projects-table">
          <thead>
            <tr>
              <th>Learning Track</th>
              <th>Progress</th>
              <th>Completed Projects</th>
              <th>Total Projects</th>
            </tr>
          </thead>
          <tbody>
            <% safeReports.forEach((r) => { %>
              <%
                const progress = Number(r.progress ?? 0);
              %>
              <tr>
                <td><%= r.track_name %></td>

                <td style="min-width:200px;">
                  <div class="ttl-progress-container">
                    <div class="ttl-progress-bar" style="width:<%= progress %>%;"></div>
                  </div>
                  <small><%= progress %>%</small>
                </td>

                <td><span class="badge ttl-badge"><%= r.completed_projects %></span></td>
                <td><span class="badge ttl-badge"><%= r.total_projects %></span></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </main>
</div>

<%- include('partials/footer') %>